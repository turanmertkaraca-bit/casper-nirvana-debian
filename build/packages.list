# CasperOS — Debian 13 trixie package set (amd64).
# Hand-picked, no metapackages. Install-Recommends is off system-wide.
#
# There is NO GNOME here. It was the largest single consumer of both image
# space and RAM, and this tablet only ever runs one session: Hyprland with
# the Caelestia shell (Quickshell), installed by build/hypr/install-hyprshell.sh.

# ── base system ────────────────────────────────────────────────────────────
systemd
systemd-sysv
udev
kmod
procps
iproute2
util-linux
e2fsprogs
mount
adduser
passwd
login
bash
coreutils
debconf
findutils
grep
sed
gawk
gzip
tar
diffutils
hostname
ncurses-base
ncurses-bin
perl-base
dpkg
apt
locales
tzdata
ca-certificates
sudo
usbutils
pciutils
curl
wget
unzip
nano
less
console-setup
keyboard-configuration
efibootmgr
systemd-timesyncd
# parted is not just a build-time tool: /usr/local/bin/casper-growroot calls
# `parted -s "$disk" resizepart` on first boot to grow the root partition to
# fill the eMMC. It was missing from this list, so the documented
# "root partition auto-resizes" step failed silently on the device (the script
# logs "parted failed" and gives up).
parted

# ── kernel (Debian 6.12 default) ───────────────────────────────────────────
linux-image-amd64

# ── bootloader: 32-bit UEFI is MANDATORY for Bay Trail (32-bit firmware) ──
grub-efi-ia32-bin
grub2-common
initramfs-tools
plymouth
plymouth-themes

# ── firmware (non-free-firmware) ───────────────────────────────────────────
firmware-realtek
firmware-intel-sound
firmware-misc-nonfree
intel-microcode

# ── session: greetd autologin -> Hyprland -> Caelestia ─────────────────────
# greetd replaces GDM: it is a few hundred KB, needs no GTK, and starts the
# session directly (see /etc/greetd/config.toml). Hyprland and Quickshell
# themselves come from trixie-backports in the hypr layer.
greetd
polkitd
dconf-gsettings-backend
gsettings-desktop-schemas
gvfs
gvfs-backends
udisks2
thunar
thunar-volman
foot
network-manager
xdg-desktop-portal
xdg-desktop-portal-gtk
xdg-user-dirs
adwaita-icon-theme
fonts-dejavu-core
power-profiles-daemon
xwayland

# ── touch / input tooling ──────────────────────────────────────────────────
libinput-tools
iw

# ── audio (PipeWire + WirePlumber, Bay Trail SST) ──────────────────────────
pipewire
pipewire-pulse
pipewire-audio-client-libraries
wireplumber
libspa-0.2-bluetooth
gstreamer1.0-pipewire
gstreamer1.0-pulseaudio
alsa-utils
alsa-ucm-conf

# ── performance on 2 GB RAM ────────────────────────────────────────────────
earlyoom
zram-tools
zstd

# ── video acceleration (legacy i965 driver = Bay Trail correct one) ───────
vainfo
i965-va-driver
libva2
mesa-va-drivers
libgl1-mesa-dri

# ── apps ───────────────────────────────────────────────────────────────────
# No Wine: it was the largest block in the image (and pulled in an i386
# multiarch tree on top), and a 2 GB Atom is not a place to run Windows
# binaries. mpv plays local media; firefox-esr is the browser.
firefox-esr
mpv
