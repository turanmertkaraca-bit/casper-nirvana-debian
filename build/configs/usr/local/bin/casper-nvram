#!/bin/bash
# CasperOS — first-boot: repair the firmware's UEFI NVRAM boot entries.
# Bay Trail 32-bit firmwares often lose/never create entries; the removable
# BOOTIA32.EFI path is what saves us, and this makes it permanent.
set -u
root_dev=$(findmnt -n -o SOURCE /) || exit 0
disk=$(lsblk -no pkname "$root_dev" 2>/dev/null)
[ -n "${disk:-}" ] || exit 0
esp_num=$(lsblk -no PARTNO "$(findmnt -n -o SOURCE /boot/efi)" 2>/dev/null)
esp_num=${esp_num:-1}

efibootmgr -d "/dev/$disk" -p "$esp_num" -l '\EFI\CasperOS\BOOTIA32.EFI' -c -L 'CasperOS' 2>/dev/null || \
    logger "casper-nvram: efibootmgr failed (firmware may ignore this; removable path still works)"
touch /var/lib/casper-nvram.done
logger "casper-nvram: done"
