# CasperOS — tablet UX defaults (user session, via system dconf)

[org/gnome/desktop/interface]
text-scaling-factor=1.15
enable-hot-corners=false
font-antialiasing='rgba'
font-hinting='slight'
enable-animations=true

[org/gnome/desktop/input-sources]
sources=[('xkb','tr')]

[org/gnome/mutter]
edge-tiling=false
draggable-border-width=24

[org/gnome/desktop/a11y/applications]
screen-keyboard-enabled=true

[org/gnome/settings-daemon/peripherals/touchscreen]
orientation-lock=false

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-ac-timeout=0
sleep-inactive-battery-type='suspend'
sleep-inactive-battery-timeout=1800
ambient-enabled=false

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true

[org/gnome/desktop/screensaver]
lock-enabled=true

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop','firefox-esr.desktop','org.gnome.Console.desktop','mpv.desktop']
