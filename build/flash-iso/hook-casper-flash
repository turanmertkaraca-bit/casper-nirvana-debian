#!/bin/sh
# initramfs-tools hook: installs the CasperOS auto-flash /init.
# Runs inside the flash-ISO chroot during update-initramfs.
# The custom init replaces the default one entirely: no systemd, no root
# mount — the initramfs itself is the whole environment.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in
    prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

copy_exec /bin/busybox /bin
copy_exec /bin/busybox /sbin/modprobe 2>/dev/null || true

cat > "${DESTDIR}/init" <<'INITEOF'
#!/bin/sh
# CasperOS Auto-Flash — custom initramfs init.
# Finds casper-n220.img on any attached disk partition, flashes the OTHER
# disk, and reboots. No keyboard needed — 10 second countdown, auto-proceed.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
BB=/bin/busybox

$BB mkdir -p /proc /sys /dev /dev/pts /tmp /run /mnt
$BB mount -t proc proc /proc 2>/dev/null
$BB mount -t sysfs sysfs /sys 2>/dev/null
$BB mount -t devtmpfs devtmpfs /dev 2>/dev/null
$BB mount -t devpts devpts /dev/pts 2>/dev/null

# kmod's modprobe handles compressed (.ko.xz) modules; busybox cannot.
MODPROBE=/sbin/modprobe
[ -x "$MODPROBE" ] || MODPROBE="$BB modprobe"
# prefer util-linux mount (accurate errors); busybox as fallback
MOUNT=/bin/mount
[ -x "$MOUNT" ] || MOUNT="$BB mount"
msg "filesystems: $(cat /proc/filesystems 2>/dev/null | tr '\n' ' ')"

msg() { echo "casper-flash: $*"; }
die() {
    msg "FATAL: $*"
    msg "Dropping to a shell. The image file must be named exactly"
    msg "'casper-n220.img' on the USB stick (any filesystem)."
    exec /bin/sh
}

# filesystem + disk drivers (no udev here — we must load them ourselves)
MPS=""
for m in ahci ata_piix sd_mod mmc_block mmc_core exfat vfat fat ext4 isofs; do
    e=$($MODPROBE "$m" 2>&1) || MPS="$MPS $m:$e"
done
[ -z "$MPS" ] || msg "modprobe issues:$MPS"
msg "loaded: $(cat /proc/modules 2>/dev/null | grep -E 'ahci|libata|sd_mod|mmc|vfat|fat|exfat|ext4' | tr '\n' ' ')"
msg "ata mods: $(ls /lib/modules/*/kernel/drivers/ata/ 2>/dev/null | tr '\n' ' ')"
msg "pci: $(ls /sys/bus/pci/devices/ 2>/dev/null | tr '\n' ' ')"
msg "block: $(ls /sys/block 2>/dev/null | tr '\n' ' ')"

msg "waiting for disks..."
DEVS=""
for try in 1 2 3 4 5; do
    DEVS=""
    for d in /sys/block/sd[a-z] /sys/block/mmcblk[0-9]; do
        [ -d "$d" ] && DEVS="$DEVS $(basename "$d")"
    done
    [ -n "$DEVS" ] && break
    $BB sleep 2
done
msg "disks present:${DEVS:- none}"
# opening a disk triggers the kernel's lazy partition scan (no udev here)
for d in $DEVS; do
    $BB dd if="/dev/$d" of=/dev/null bs=512 count=1 2>/dev/null
done
$BB sleep 2
# devtmpfs may still lag on partition nodes — build them from /proc/partitions
$BB cat /proc/partitions 2>/dev/null | while read maj min blk name; do
    case "$name" in
        sd[a-z]|sd[a-z][0-9]*|mmcblk[0-9]|mmcblk[0-9]p[0-9]*)
            [ -e "/dev/$name" ] || $BB mknod "/dev/$name" b "$maj" "$min" 2>/dev/null
            ;;
    esac
done
$BB sleep 1
msg "partitions:$(ls /dev/sd*[0-9]* /dev/mmcblk*[0-9]* 2>/dev/null | tr '\n' ' ')"
msg "sda dev: $(ls -l /dev/sda /dev/sda1 2>/dev/null | awk '{print $5, $6, $10}' | tr '\n' ' ')"
msg "sda size: $(cat /sys/block/sda/size 2>/dev/null)"
msg "sda read: $($BB dd if=/dev/sda bs=512 count=1 2>&1 | head -2 | tr '\n' ' ')"
for p in /dev/sd*[0-9]* /dev/mmcblk*[0-9]*; do
    [ -b "$p" ] || continue
    msg "od $p: $($BB dd if="$p" bs=512 count=1 2>/dev/null | $BB od -A d -t x1z -N 16 | head -1 | tr '\n' ' ')"
done

msg "scanning disks for casper-n220.img..."
$BB sleep 2

PAYLOAD=""
SRCDISK=""
for d in /sys/block/sd[a-z] /sys/block/mmcblk[0-9]; do
    [ -d "$d" ] || continue
    disk="/dev/$(basename "$d")"
    for part in "$disk"[0-9]*; do
        [ -b "$part" ] || continue
        $BB mkdir -p /mnt
        rm -f /tmp/mterr
        if $MOUNT -t auto -o ro "$part" /mnt 2>/tmp/mterr || \
           $MOUNT -t vfat -o ro "$part" /mnt 2>>/tmp/mterr || \
           $MOUNT -t exfat -o ro "$part" /mnt 2>>/tmp/mterr; then
            msg "mounted $part"
            if [ -f /mnt/casper-n220.img ]; then
                PAYLOAD="/mnt/casper-n220.img"
                SRCDISK="$disk"
                msg "payload found on $part ($($BB stat -c %s "$PAYLOAD") bytes)"
                break 2
            fi
            msg "  (no casper-n220.img on $part)"
            $BB umount /mnt 2>/dev/null
        else
            msg "mount failed on $part: $(head -1 /tmp/mterr 2>/dev/null)"
        fi
    done
done

[ -n "$PAYLOAD" ] || die "casper-n220.img not found on any disk partition"

# target: exactly ONE other disk (cdrom sr* is never a candidate)
TARGET=""
for d in /sys/block/sd[a-z] /sys/block/mmcblk[0-9]; do
    [ -d "$d" ] || continue
    disk="/dev/$(basename "$d")"
    [ "$disk" = "$SRCDISK" ] && continue
    if [ -n "$TARGET" ]; then
        die "multiple candidate disks ($TARGET and $disk) — remove the SD card / extra drives"
    fi
    TARGET="$disk"
done
[ -n "$TARGET" ] || die "no target disk found"

PAYLOADSIZE=$($BB stat -c %s "$PAYLOAD")
TARGETSIZE=$(( $(cat "/sys/block/$(basename "$TARGET")/size") * 512 ))
[ "$TARGETSIZE" -ge "$PAYLOADSIZE" ] || die "target disk ($TARGET) is smaller than the image"

msg "==================================================="
msg "  INSTALLING CasperOS"
msg "  source: $SRCDISK : $PAYLOAD"
msg "  target: $TARGET ($TARGETSIZE bytes)"
msg "  The target disk will be OVERWRITTEN."
msg "  Remove the USB stick only after 'flash complete'."
msg "==================================================="
msg "flashing in 10 seconds..."
$BB sleep 10
msg "flashing $TARGET ..."
if $BB dd if="$PAYLOAD" of="$TARGET" bs=4M conv=fsync 2>/dev/null; then
    $BB sync
    msg "flash complete — CasperOS installed."
    msg "Remove the USB stick; rebooting in 5 seconds..."
    $BB sleep 5
    $BB reboot -f
fi
die "dd failed"
INITEOF
chmod 755 "${DESTDIR}/init"

# ensure our fs/disk modules are in the initramfs
for m in ahci ata_piix exfat vfat fat sd_mod mmc_block mmc_core ext4 isofs; do
    echo "$m" >> "${DESTDIR}/conf/modules" 2>/dev/null || true
done
