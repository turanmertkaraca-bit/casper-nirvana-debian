#!/bin/sh
# initramfs-tools hook: installs the CasperOS auto-flash /init.
# Runs inside the flash-ISO chroot during update-initramfs.
# The custom init replaces the default one entirely: no systemd, no root
# mount — the initramfs itself is the whole environment.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in
    prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

copy_exec /bin/busybox /bin
copy_exec /bin/busybox /sbin/modprobe 2>/dev/null || true
copy_exec /usr/bin/xz /usr/bin/xz 2>/dev/null || true

cat > "${DESTDIR}/init" <<'INITEOF'
#!/bin/sh
# CasperOS Auto-Flash — custom initramfs init.
# Finds casper-n220.img (on a disk partition OR embedded in the flash ISO
# itself), flashes the internal eMMC, and reboots. No keyboard needed —
# 10 second countdown, auto-proceed.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
BB=/bin/busybox

msg() { echo "casper-flash: $*"; }
die() {
    msg "FATAL: $*"
    msg "Dropping to a shell. The image must be named exactly"
    msg "'casper-n220.img' — inside this ISO or on the USB stick."
    exec /bin/sh
}

$BB mkdir -p /proc /sys /dev /dev/pts /tmp /run /mnt
$BB mount -t proc proc /proc 2>/dev/null
$BB mount -t sysfs sysfs /sys 2>/dev/null
$BB mount -t devtmpfs devtmpfs /dev 2>/dev/null
$BB mount -t devpts devpts /dev/pts 2>/dev/null

# kmod's modprobe handles compressed (.ko.xz) modules; busybox cannot.
MODPROBE=/sbin/modprobe
[ -x "$MODPROBE" ] || MODPROBE="$BB modprobe"
# prefer util-linux mount (accurate errors); busybox as fallback
MOUNT=/bin/mount
[ -x "$MOUNT" ] || MOUNT="$BB mount"

# drivers: disks, optical, SD/eMMC, filesystems
MPS=""
for m in ahci ata_piix sd_mod sr_mod mmc_block mmc_core sdhci sdhci-pci \
         exfat vfat fat nls_cp437 nls_ascii ext4 isofs; do
    e=$($MODPROBE "$m" 2>&1) || MPS="$MPS $m:$e"
done
[ -z "$MPS" ] || msg "modprobe issues:$MPS"

msg "waiting for disks..."
DEVS=""
for try in 1 2 3 4 5; do
    DEVS=""
    for d in /sys/block/sd[a-z] /sys/block/mmcblk[0-9] /sys/block/sr[0-9]; do
        [ -d "$d" ] && DEVS="$DEVS $(basename "$d")"
    done
    [ -n "$DEVS" ] && break
    $BB sleep 2
done
msg "devices present:${DEVS:- none}"

# opening a disk triggers the kernel's lazy partition scan (no udev here)
for d in $DEVS; do
    $BB dd if="/dev/$d" of=/dev/null bs=512 count=1 2>/dev/null
done
$BB sleep 2
# devtmpfs may still lag on partition nodes — build them from /proc/partitions
$BB cat /proc/partitions 2>/dev/null | while read maj min blk name; do
    case "$name" in
        sd[a-z]|sd[a-z][0-9]*|mmcblk[0-9]|mmcblk[0-9]p[0-9]*)
            [ -e "/dev/$name" ] || $BB mknod "/dev/$name" b "$maj" "$min" 2>/dev/null
            ;;
    esac
done
$BB sleep 1

PAYLOAD=""
SRCDISK=""

# find casper-n220.img (raw) or casper-n220.img.xz (compressed) on a
# mounted filesystem; returns 0 and sets PAYLOAD/SRCDISK on success
find_payload() { # $1 = mount dir, $2 = source device, $3 = source disk
    if [ -f "$1/casper-n220.img" ]; then
        PAYLOAD="$1/casper-n220.img"
        SRCDISK="$3"
        msg "payload found on $2 ($($BB stat -c %s "$PAYLOAD") bytes)"
        return 0
    fi
    if [ -f "$1/casper-n220.img.xz" ]; then
        PAYLOAD="$1/casper-n220.img.xz"
        SRCDISK="$3"
        msg "compressed payload found on $2 ($($BB stat -c %s "$PAYLOAD") bytes)"
        return 0
    fi
    return 1
}

# ── 1. search disk partitions (e.g. the USB stick's exFAT) ─────────────────
msg "scanning disk partitions for casper-n220.img[.xz]..."
for d in /sys/block/sd[a-z] /sys/block/mmcblk[0-9]; do
    [ -d "$d" ] || continue
    disk="/dev/$(basename "$d")"
    for part in "$disk"[0-9]*; do
        [ -b "$part" ] || continue
        $BB mkdir -p /mnt
        if $MOUNT -t exfat -o ro "$part" /mnt 2>/dev/null || \
           $BB mount -t vfat  -o ro "$part" /mnt 2>/dev/null || \
           $MOUNT -t vfat  -o ro "$part" /mnt 2>/dev/null; then
            msg "mounted $part"
            if find_payload /mnt "$part" "$disk"; then
                break 2
            fi
            $BB umount /mnt 2>/dev/null
        fi
    done
done

# ── 2. search the flash ISO itself (self-contained flow) ───────────────────
if [ -z "$PAYLOAD" ]; then
    msg "scanning optical drives for casper-n220.img[.xz]..."
    for cd in /dev/sr?; do
        [ -b "$cd" ] || continue
        $BB mkdir -p /mnt
        if $MOUNT -t iso9660 -o ro "$cd" /mnt 2>/dev/null || \
           $BB mount -t iso9660 -o ro "$cd" /mnt 2>/dev/null; then
            msg "mounted $cd"
            if find_payload /mnt "$cd" "$cd"; then
                break
            fi
            msg "  (no casper-n220.img[.xz] on $cd)"
        fi
    done
fi

[ -n "$PAYLOAD" ] || die "casper-n220.img[.xz] not found (not on the stick, not in the ISO)"

# ── 3. target: exactly ONE internal eMMC/SD disk (the stick is USB/CD) ─────
TARGET=""
for d in /sys/block/mmcblk[0-9]; do
    [ -d "$d" ] || continue
    disk="/dev/$(basename "$d")"
    [ "$disk" = "$SRCDISK" ] && continue
    if [ -n "$TARGET" ]; then
        die "multiple internal disks ($TARGET and $disk) — remove the SD card / extra drives"
    fi
    TARGET="$disk"
done
[ -n "$TARGET" ] || die "no internal (eMMC) target disk found"

PAYLOADSIZE=$($BB stat -c %s "$PAYLOAD")
case "$PAYLOAD" in
    *.xz)
        # decompressed size from the xz stream header (fast, no I/O)
        XZSIZE=$(xz --robot -l "$PAYLOAD" 2>/dev/null | head -1 | awk '{print $5}')
        [ -n "$XZSIZE" ] && [ "$XZSIZE" -gt 0 ] 2>/dev/null && PAYLOADSIZE="$XZSIZE"
        ;;
esac
TARGETSIZE=$(( $(cat "/sys/block/$(basename "$TARGET")/size") * 512 ))
[ "$TARGETSIZE" -ge "$PAYLOADSIZE" ] || die "target disk ($TARGET) is smaller than the image"

msg "==================================================="
msg "  INSTALLING CasperOS"
msg "  source: $SRCDISK : $PAYLOAD"
msg "  target: $TARGET ($TARGETSIZE bytes, image $PAYLOADSIZE bytes)"
msg "  The target disk will be OVERWRITTEN."
msg "  Remove the USB stick only after 'flash complete'."
msg "==================================================="
msg "flashing in 10 seconds..."
$BB sleep 10
msg "flashing $TARGET ..."
case "$PAYLOAD" in
    *.xz)
        # stream-decompress straight onto the target (no intermediate file);
        # dd's exit status covers xz failures too (read error -> exit 1)
        xz -dc "$PAYLOAD" 2>/dev/null | $BB dd of="$TARGET" bs=4M conv=fsync 2>/dev/null
        ;;
    *)
        $BB dd if="$PAYLOAD" of="$TARGET" bs=4M conv=fsync 2>/dev/null
        ;;
esac
if [ $? -eq 0 ]; then
    $BB sync
    msg "flash complete — CASPER_FLASH_DONE"
    msg "CasperOS installed. Remove the USB stick; rebooting in 5 seconds..."
    $BB sleep 5
    $BB reboot -f
fi
die "dd failed"
INITEOF
chmod 755 "${DESTDIR}/init"

# ensure our fs/disk modules are in the initramfs
for m in ahci ata_piix sd_mod sr_mod mmc_block mmc_core sdhci sdhci-pci \
         exfat vfat fat nls_cp437 nls_ascii ext4 isofs; do
    echo "$m" >> "${DESTDIR}/conf/modules" 2>/dev/null || true
done
